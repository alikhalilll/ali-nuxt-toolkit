{
  "name": "@alikhalilll/a-ghost-skeleton",
  "version": "2.1.2",
  "description": "Measured skeleton loaders for Vue 3 / Nuxt 3+. Lays the real content out unseen, draws a skeleton from its geometry, then reveals it with smart, sequence, sweep or together animations.",
  "license": "MIT",
  "author": "alikhalilll",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alikhalilll/ali-nuxt-toolkit.git",
    "directory": "packages/ui-components/AGhostSkeleton"
  },
  "homepage": "https://alikhalilll.github.io/ali-nuxt-toolkit/ui/ghost-skeleton",
  "bugs": {
    "url": "https://github.com/alikhalilll/ali-nuxt-toolkit/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/element/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "skeleton",
    "skeleton-loader",
    "skeleton-screen",
    "skeleton-component",
    "skeleton-animation",
    "loading-skeleton",
    "page-skeleton",
    "card-skeleton",
    "list-skeleton",
    "vue-skeleton",
    "vue-skeleton-loader",
    "nuxt-skeleton",
    "nuxt-skeleton-loader",
    "ghost-loader",
    "ghost-skeleton",
    "measured-skeleton",
    "content-aware-skeleton",
    "auto-skeleton",
    "automatic-skeleton",
    "loading-placeholder",
    "loading-state",
    "placeholder-loader",
    "shimmer",
    "shimmer-effect",
    "pulse",
    "pulse-loader",
    "cls",
    "zero-cls",
    "no-cls",
    "layout-shift",
    "cumulative-layout-shift",
    "web-vitals",
    "core-web-vitals",
    "suspense",
    "ssr",
    "ssr-skeleton",
    "headless",
    "web-components",
    "vue",
    "vue3",
    "nuxt",
    "nuxt3",
    "nuxt4",
    "nuxt-module",
    "typescript"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element/index.d.ts",
        "default": "./dist/element/index.js"
      },
      "require": {
        "types": "./dist/element/index.d.cts",
        "default": "./dist/element/index.cjs"
      }
    },
    "./nuxt": {
      "import": {
        "types": "./dist/nuxt/index.d.ts",
        "default": "./dist/nuxt/index.js"
      },
      "require": {
        "types": "./dist/nuxt/index.d.cts",
        "default": "./dist/nuxt/index.cjs"
      }
    },
    "./resolver": {
      "import": {
        "types": "./dist/resolver/index.d.ts",
        "default": "./dist/resolver/index.js"
      },
      "require": {
        "types": "./dist/resolver/index.d.cts",
        "default": "./dist/resolver/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "web-types": "./web-types.json",
  "files": [
    "dist",
    "src",
    "web-types.json",
    "logo.svg",
    "logo-dark.png",
    "logo-light.png",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rimraf dist web-types.json",
    "build": "node scripts/build-inline.mjs && tsx ../../../scripts/build/run-component-build.ts && node scripts/build-css.mjs",
    "dev": "node scripts/build-inline.mjs && tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "validate-dist": "tsx ../../../scripts/validate/dist-validate.ts --pkg a-ghost-skeleton",
    "validate-consumer": "tsx ../../../scripts/validate/consumer-validate.ts --pkg a-ghost-skeleton",
    "validate": "pnpm build && pnpm validate-dist && pnpm validate-consumer",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm validate"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3.0.0 || ^4.0.0",
    "@vueuse/core": "^14.0.0",
    "unplugin-vue-components": "^28.0.0 || ^29.0.0 || ^30.0.0 || ^31.0.0 || ^32.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "unplugin-vue-components": {
      "optional": true
    }
  },
  "devDependencies": {
    "@alikhalilll/a-ui-base": "workspace:*",
    "@nuxt/kit": "^4.4.2",
    "@nuxt/schema": "^4.4.2",
    "@tailwindcss/cli": "^4.0.0",
    "@types/node": "^22.13.0",
    "@vueuse/core": "^14.0.0",
    "esbuild": "^0.27.7",
    "happy-dom": "^20.12.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.0.0",
    "tsdown": "0.22.0",
    "typescript": "^5.9.2",
    "unplugin-vue": "7.2.0",
    "unplugin-vue-components": "^32.1.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.0",
    "vue-tsc": "^3.2.4"
  }
}
